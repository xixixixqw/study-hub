# ===== Supabase =====
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== Edge Function 环境变量（在 Supabase Dashboard → Edge Functions → Secrets 里配置）=====
# 群暗号（不要写进前端）
GROUP_CODE=9班yyds
# 管理员邮箱白名单，逗号分隔；命中即 role='admin'
ADMIN_EMAILS=2219158964@qq.com

# ===== 可选：Web Push（VAPID）=====
# 生成：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== 可选：邮件提醒（Resend）=====
# https://resend.com/api-keys
RESEND_API_KEY=
REMINDER_FROM=学习资料库 <noreply@yourdomain.com>

# ===== 其它 =====
# Edge Function 内用：应用线上地址（用于邮件/推送里的链接）
APP_URL=https://your-app.vercel.app
# 可选：给 cron 调用加鉴权
CRON_SECRET=